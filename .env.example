# --- Brain (local-first; everything here is optional — EchoEngine runs keyless) ---
OLLAMA_HOST=http://localhost:11434
# Recommended local model on 8GB: `ollama pull llama3.2:3b` (fast instruct model).
# Keep just ONE model loaded on 8GB — two large models thrash RAM and stall.
# Optional cloud brain (asked before use): set ORIGAMI_CLOUD=groq and GROQ_API_KEY=...
# ORIGAMI_CLOUD=groq

# --- Spotify (optional — needed only for real playback in the Phase 1 slice) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Anthropic (optional — Claude Code via the CLI/subscription needs no key) ---
ANTHROPIC_API_KEY=
